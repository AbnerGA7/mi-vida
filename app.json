{
  "expo": {
    "name": "Mi Vida",
    "slug": "mi-vida",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "mivida",
      "com.abnerga7.mivida"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abnerga7.mivida"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mi Vida usa Face ID para proteger tus datos."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mi Vida usa la cámara para escanear tus documentos y boletas.",
          "photosPermission": false
        }
      ],
      "expo-notifications",
      "expo-speech-recognition",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.rnllama.** { *; }\n-keep class com.rnmlkit.** { *; }\n-keep class org.songsterq.pdfthumbnail.** { *; }\n-keep class expo.modules.speechrecognition.** { *; }"
          }
        }
      ],
      "./plugins/with-fast-gradle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
